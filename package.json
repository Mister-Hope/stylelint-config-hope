{
  "name": "stylelint-config-hope",
  "version": "12.1.0",
  "description": "Shareable config for Stylelint",
  "keywords": [
    "stylelint",
    "stylelint-config"
  ],
  "homepage": "https://github.com/Mister-Hope/stylelint-config-hope",
  "bugs": {
    "url": "https://github.com/Mister-Hope/stylelint-config-hope/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Mr.Hope",
    "email": "mister-hope@outlook.com",
    "url": "https://mister-hope.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mister-Hope/stylelint-config-hope.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "prepare": "husky",
    "prepublish": "pnpm run build",
    "test": "stylelint tests/**/*.scss"
  },
  "dependencies": {
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2"
  },
  "devDependencies": {
    "@mr-hope/tsconfig": "0.0.4",
    "@types/node": "^24.19.2",
    "husky": "9.1.7",
    "import-meta-resolve": "^4.2.0",
    "nano-staged": "1.0.2",
    "oxc-config-hope": "0.3.15",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "stylelint": "17.16.0",
    "tsdown": "0.23.2",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "postcss-html": "^2.0.0",
    "stylelint": "^17.0.0"
  },
  "peerDependenciesMeta": {
    "postcss-html": {
      "optional": true
    }
  },
  "nano-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts}": "oxlint --fix"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^22.23.4 || ^24.22.1 || ^26.12.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "inlinedDependencies": {
    "import-meta-resolve": "4.2.0"
  }
}
